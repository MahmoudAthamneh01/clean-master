{
    "name": "cleanease-pro-backend",
    "description": "CleanEase Pro Backend API - PHP Slim Framework",
    "type": "project",
    "require": {
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.0",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.5",
        "illuminate/database": "^10.0",
        "illuminate/pagination": "^10.0",
        "respect/validation": "^2.2",
        "guzzlehttp/guzzle": "^7.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "api/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse api --level 8"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}